{
  // Editor
  "editor.minimap.enabled": true,
  "editor.renderWhitespace": "boundary",
  "editor.tabSize": 2,
  "editor.snippetSuggestions": "bottom",
  "editor.fontFamily": "Fira Code",
  "editor.fontLigatures": true,
  "editor.lineHeight": 24,
  "editor.formatOnSave": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "explorer.confirmDelete": false,
  "files.exclude": {
    "**/.git": false
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/graphql-schema.json": true,
    "**/build": true,
    "**/dist": true,
    "**/collected_static": true,
    "**/linkchecking": true,
    "**/public": false,
    "**/.git": true,
    "**/.cache": true,
    "**/public/page-data": true,
    "**/public/static": true,
    "**/errored.tfstate": true,
    "**/*.log": true,
    "**/segment/js/*": true,
    "**/.next": true
  },
  "files.associations": {
    "*.symlink": "shellscript",
    "*.env": "properties",
    "default-packages": "shellscript",
    "*.graphcoolrc": "yaml",
    "*.tmp": "javascript",
    "*.dbdiagram.io": "sql"
  },
  "files.insertFinalNewline": true,
  // Git
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  // Syntax specific
  "javascript.suggestionActions.enabled": false,
  "javascript.updateImportsOnFileMove.enabled": "never",
  "typescript.updateImportsOnFileMove.enabled": "never",
  "css.validate": false,
  // Extensions
  "extensions.ignoreRecommendations": true,
  // Prettier
  "prettier.singleQuote": true,
  "prettier.tabWidth": 2,
  "prettier.printWidth": 100,
  "prettier.semi": true,
  "workbench.iconTheme": "Monokai Pro (Filter Machine) Icons",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.colorCustomizations": {
    "editorInfo.foreground": "#00689c"
  },
  "material-icon-theme.files.associations": {
    // For non-Angular services
    "*.service.ts": "typescript",
    "*.symlink": "console",
    "Gemfile": "ruby",
    "*.graphcoolrc": "yaml",
    "*.dbdiagram.io": "Database"
  },
  "editor.suggestSelection": "first",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "npm.packageManager": "yarn",
  "eslint.validate": ["javascript", "javascriptreact", "html", "typescriptreact"],
  "eslint.trace.server": "verbose",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[graphql]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },
  "github.copilot.advanced": {},
  "github.copilot.enable": {
    "*": true,
    "yaml": true,
    "plaintext": true,
    "markdown": true
  },
  "editor.inlineSuggest.enabled": true,
  "window.zoomLevel": 1,
  "npm.keybindingsChangedWarningShown": true,
  "playwright.reuseBrowser": true,
  "playwright.showTrace": false,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.editor.temporalContext.enabled": true,
  "github.copilot.chat.edits.temporalContext.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.search.semanticTextResults": true,
  "extensions.trustedPublishers": [
    "aessoft",
    "andys8",
    "apollographql",
    "batisteo",
    "brunnerh",
    "bungcip",
    "christian-kohler",
    "cymonk",
    "danielpinto8zz6",
    "davidanson",
    "dbankier",
    "deerawan",
    "donjayamanne",
    "eamodio",
    "eg2",
    "equinusocio",
    "esbenp",
    "formulahendry",
    "glen-84",
    "jbenden",
    "jeremyrajan",
    "jithurjacob",
    "kaiwood",
    "kevinrose",
    "magicstack",
    "misogi",
    "njpwerner",
    "octref",
    "ofhumanbondage",
    "orta",
    "perkovec",
    "pkief",
    "rebornix",
    "rust-lang",
    "third774",
    "toba",
    "tobermory",
    "tokoph",
    "waderyan",
    "wholroyd",
    "wingrunr21"
  ],
  "github.copilot.chat.enableUserPreferences": true,
  "workbench.colorTheme": "Atom Material Theme",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:claude-sonnet-4",
  "security.promptForLocalFileProtocolHandling": false,
  "githubPullRequests.pullBranch": "never",
  "remote.autoForwardPortsSource": "hybrid"
}
